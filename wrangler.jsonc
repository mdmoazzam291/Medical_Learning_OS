{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medical-learning-os",
  "main": "cloudflare/edge-worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist-pages",
    "run_worker_first": false
  },
  "vars": {
    "ORIGIN_BASE_URL": "https://medical-learning-os-preview.onrender.com"
  }
}
